{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
	"source": "$HOME/.config/fastfetch/cat.txt",
	"padding": {
	   "top": 2,
	   "left": 1
	},
	"color": {"1": "black"}
  },
  "modules": [
    "title",
    "separator",
    {
	"type": "os",
	"key": "\u001b[3mos \u001b[23m"
    },
    {
	"type": "kernel",
	"key": "\u001b[3mkern \u001b[23m"
    },
    {
	"type": "cpu",
	"key": "\u001b[3mcpu \u001b[23m"
    },
    {
	"type": "gpu",
	"key": "\u001b[3mgpu \u001b[23m"
    },
    {
	"type": "memory",
	"key": "\u001b[3mmem \u001b[23m"
    },
    {
	"type": "swap",
	"key": "\u001b[3mswp \u001b[23m"
    },
    {
	"type": "disk",
	"key": "\u001b[3mdisk \u001b[23m"
    },
    {
	"type": "shell",
	"key": "\u001b[3msh \u001b[23m"
    },
    {
	"type": "uptime",
	"key": "\u001b[3mup \u001b[23m"
    },
    "break",
    "colors"
  ]
}
